# Copy to .env; load explicitly with npm run start:env (Node >=20.11).
TEXT_PROVIDER=template
TTS_PROVIDER=edge
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.6-flash
MIMO_TTS_MODEL=mimo-v2.5-tts
TEXT_TIMEOUT_MS=20000
TTS_TIMEOUT_MS=45000
AI_MAX_CONCURRENT=4
AI_REQUESTS_PER_MINUTE=30
HOST=127.0.0.1
PORT=3000
TTS_PROXY=
# Exact origin, no path; CORS is not authentication.
ALLOWED_ORIGINS=
